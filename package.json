{
  "name": "xkey",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "all": "bun run --parallel build check cpd knip typecheck",
    "build": "bun run build.ts",
    "check": "biome check --error-on-warnings",
    "checkfix": "biome check --write",
    "cpd": "jscpd",
    "knip": "knip",
    "pack:zip": "bun run build.ts --zip",
    "typecheck": "bun check --no-script"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "chrome-types": "^0.1.461",
    "jscpd": "^5.4.2",
    "knip": "^6.44.1"
  }
}
