{
  "name": "xkey",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "all": "bun run --parallel build check cpd knip typecheck",
    "build": "bun run build.ts",
    "check": "biome check --error-on-warnings",
    "checkfix": "biome check --write",
    "cpd": "jscpd",
    "knip": "knip",
    "pack:zip": "bun run build.ts --zip",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "latest",
    "chrome-types": "^0.1.429",
    "jscpd": "^4.2.4",
    "knip": "^6.15.0",
    "typescript": "^6.0.3"
  }
}
