{
  "name": "x-show-more-hotkey",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "all": "bun run --parallel build check jscpd knip typecheck",
    "build": "bun run build.ts",
    "check": "biome check --error-on-warnings",
    "checkfix": "biome check --write",
    "jscpd": "jscpd",
    "knip": "knip",
    "pack:crx": "bun run build.ts --crx",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/bun": "latest",
    "chrome-types": "^0.1.427",
    "jscpd": "^4.1.1",
    "knip": "^6.13.1",
    "typescript": "^6.0.3"
  }
}
