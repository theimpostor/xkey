{
  "manifest_version": 3,
  "name": "X Keyboard Extras",
  "description": "Adds keyboard shortcuts for Show more, Grok, referenced tweets, and screenshots on x.com posts.",
  "version": "0.1.1",
  "permissions": ["clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
